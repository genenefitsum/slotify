PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/slotify
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=google-oauth-client-id.apps.googleusercontent.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_VENDOR_FOLDER=slotify/vendors
# SMTP email (password-reset codes). For Gmail: create an App Password
# (Google Account → Security → App passwords) and use it as SMTP_PASS.
# Leave SMTP_HOST empty in dev to log codes to the console instead of sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=Slotify <your-gmail-address@gmail.com>
APP_NAME=Slotify
PASSWORD_RESET_CODE_TTL_MINUTES=10
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_AUTH_MAX_REQUESTS=30
