# Base URL of the Slotify backend API (same contract as the web app).
# MUST include the /api path prefix (routes are mounted under /api).
# EXPO_PUBLIC_ vars are inlined at build time — restart Metro with `-c` after changes.
# Local:    http://localhost:5000/api  (use your LAN IP on a physical device)
# Deployed: https://slotify-backend-cet8.onrender.com/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Google sign-in. Reuse the SAME Web OAuth client ID as the web app
# (frontend VITE_GOOGLE_CLIENT_ID) — the backend verifies the ID token's
# audience against it, so no backend change is needed. Mint iOS/Android client
# IDs in the same Google Cloud project; native Google sign-in needs a dev build.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=google-oauth-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=google-oauth-ios-client-id.apps.googleusercontent.com
