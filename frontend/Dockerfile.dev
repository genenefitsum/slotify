FROM node:20-alpine

WORKDIR /app

# Copy dependency manifests
COPY package*.json ./

# Install all dependencies (including devDependencies for Vite)
RUN npm install

# Copy source
COPY . .

# Expose Vite dev server port
EXPOSE 5175

# Run Vite dev server with host and port
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5175"]
